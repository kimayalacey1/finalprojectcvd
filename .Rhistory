y = "Mortality Rate per 100,000"
) +
theme_minimal() +
theme(
plot.title = element_text(
face = "bold",
size = 16
),
plot.subtitle = element_text(size = 11),
axis.text = element_text(size = 11),
legend.position = "none",
panel.grid.major.x = element_blank()
)
# Convert to interactive plot
interactive_sex <- ggplotly(
sex_plot,
tooltip = "text"
)
interactive_sex
state_comparison <- subplot(
interactive_top,
interactive_bottom,
nrows = 1,
shareY = FALSE,
titleX = TRUE,
titleY = FALSE,
margin = 0.08
) %>%
layout(
title = list(
text = "Cardiovascular Mortality: Highest vs. Lowest Counties in 2022"
),
showlegend = FALSE
)
state_comparison
highest_rate <- max(
location_summary$mortality_rate,
na.rm = TRUE
)
lowest_rate <- min(
location_summary$mortality_rate,
na.rm = TRUE
)
mortality_difference <- highest_rate - lowest_rate
print(mortality_difference)
