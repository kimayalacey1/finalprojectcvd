interactive_bar <- ggplot(
data = state_summary,
mapping = aes(
x = location,
y = mortality_rate,
fill = mortality_rate,
text = hover_text
)
) +
geom_col(width = 0.7) +
coord_flip() +
scale_fill_gradient(
low = "#F2B8C1",
high = "#5C0A16"
) +
labs(
title = "Top 10 States with the Highest Cardiovascular Mortality Rates in 2022",
subtitle = "Age-adjusted, spatially smoothed, 3-year average rate (2022)",
x = NULL,
y = "Mortality rate per 100,000 population",
fill = "Mortality Rate"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
face = "bold",
size = 16,
color = "#5C0A16"
),
plot.subtitle = element_text(color = "gray40"),
axis.text = element_text(color = "gray25"),
panel.grid.major.y = element_blank(),
legend.position = "none"
)
ggplotly(interactive_bar, tooltip = "text") %>%
config(
displaylogo = FALSE,
responsive = TRUE
)
